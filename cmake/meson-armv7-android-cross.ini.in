# Meson cross file: build DXVK (native mode, SDL3 WSI) for Android armeabi-v7a
# using the NDK's 32-bit ARM clang drivers.
#
# Generated by cmake/dx8.cmake from ANDROID_NDK_HOME / CMAKE_ANDROID_NDK.
# @ANDROID_TOOLCHAIN_BIN@ -> <ndk>/toolchains/llvm/prebuilt/<host>/bin
# @ANDROID_API@ -> minimum API level (matches ANDROID_PLATFORM)

[binaries]
c = '@ANDROID_TOOLCHAIN_BIN@/armv7a-linux-androideabi@ANDROID_API@-clang'
cpp = '@ANDROID_TOOLCHAIN_BIN@/armv7a-linux-androideabi@ANDROID_API@-clang++'
ar = '@ANDROID_TOOLCHAIN_BIN@/llvm-ar'
strip = '@ANDROID_TOOLCHAIN_BIN@/llvm-strip'
pkg-config = 'pkg-config'

[host_machine]
system = 'android'
cpu_family = 'arm'
cpu = 'armv7'
endian = 'little'

[built-in options]
c_args = ['-fPIC']
cpp_args = ['-fPIC', '-DVK_ENABLE_BETA_EXTENSIONS']
c_link_args = []
cpp_link_args = ['-static-libstdc++']

[properties]
pkg_config_libdir = '@DXVK_SDL3_PC_DIR@'
